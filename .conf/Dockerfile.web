# 1st stage: Build Vue application
FROM node:20-alpine AS vue_builder

WORKDIR /app

# 国内镜像源(npm/pnpm 均读此变量;npmmirror 与 npmjs 内容一致,integrity 校验不受影响)
ENV NPM_CONFIG_REGISTRY=https://registry.npmmirror.com
# 产物是 nginx 静态 Web,不需要 Electron 运行时二进制;
# 不跳过则 postinstall 从 GitHub releases 下载(国内断网,曾卡 97s 后失败)
ENV ELECTRON_SKIP_BINARY_DOWNLOAD=1

# Install pnpm
RUN npm install -g pnpm

# Copy package files first for better caching
COPY frontend/package.json frontend/pnpm-lock.yaml ./

# Install dependencies using pnpm
RUN pnpm install --frozen-lockfile

# Copy source code
COPY frontend/ ./

# Build the Vue app (output goes to dist/)
RUN pnpm build

# 2nd stage: Serve with nginx
FROM nginx:1.27.0-alpine AS vue_runtime

# Copy the built Vue app from the builder stage
# vite root=src/renderer + outDir=dist → 产物在 /app/src/renderer/dist
COPY --from=vue_builder /app/src/renderer/dist /usr/share/nginx/html

# Copy custom nginx config if exists (build context is .., so .conf/ is correct)
COPY .conf/nginx.conf /etc/nginx/nginx.conf
RUN chown -R nginx:nginx /usr/share/nginx/html /var/cache/nginx /var/run /var/log/nginx

# Expose the port (8080: non-root nginx can bind ≥1024; aligns with USER nginx)
EXPOSE 8080

USER nginx

# Run Nginx in foreground
CMD ["nginx", "-g", "daemon off;"]
